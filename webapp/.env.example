# webapp/.env.example — configuration du cockpit (backend + frontend).
#
# Copier en `webapp/.env` puis ajuster. Ce fichier est lu par `start-dev.sh`
# (lancement conjoint uvicorn + vite). Il ne contient AUCUN secret : le cockpit
# est en lecture seule et ne fait aucun appel d'API externe.
#
#   cp webapp/.env.example webapp/.env
#   ./webapp/start-dev.sh

# ---------------------------------------------------------------------------
# Backend (FastAPI, read-only)
# ---------------------------------------------------------------------------

# Racine du vault Obsidian lu par l'API. Défaut : <racine_repo>/vault
VAULT_PATH=vault

# Grand livre d'usage API (JSONL append-only) — source de /api/usage et
# /api/greenit, et fichier suivi en temps réel par /api/greenit/stream.
# Défaut : <racine_repo>/api_usage.log
API_USAGE_LOG=api_usage.log

# Journal des écritures vault, source de /api/runs. Défaut : <racine_repo>/runs.log
RUNS_LOG=runs.log

# Racine utilisée par le contrôle `tests_verts` du préflight. Le pointer sur un
# dossier sans tests évite de relancer toute la suite pytest en sous-processus
# à chaque appel de /api/preflight (utile en dev, à laisser vide en usage réel).
# PREFLIGHT_ROOT_DIR=

# Port d'écoute d'uvicorn.
API_PORT=8000

# ---------------------------------------------------------------------------
# Frontend (Vite + React)
# ---------------------------------------------------------------------------

# Port du serveur de dev Vite (doit rester dans les origines CORS du backend).
WEB_PORT=5173

# false => le front tape le VRAI backend via le proxy Vite /api -> API_PORT.
# true  => fixtures locales, aucune requête réseau (démo hors-ligne).
VITE_USE_MOCKS=false

# Cible du proxy Vite pour /api. Défaut : http://localhost:8000
# VITE_API_TARGET=http://localhost:8000
