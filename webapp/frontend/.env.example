# Mode mock : true (défaut en dev) => l'app tourne sans backend, fixtures locales.
# false => le client tape /api (proxifié vers http://localhost:8000 par Vite).
VITE_USE_MOCKS=true

# Cible du proxy Vite pour /api. À changer si le backend n'écoute pas sur 8000.
# VITE_API_TARGET=http://localhost:8000

# Astuce : pour lancer backend + front ensemble et déjà branchés, utiliser
#   ./webapp/start-dev.sh
# (il pose VITE_USE_MOCKS=false et VITE_API_TARGET tout seul — voir webapp/.env.example)
